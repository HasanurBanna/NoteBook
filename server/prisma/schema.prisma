// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// User Model
model User {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  email    String   @unique
  password String
  avater   String?
  createAT DateTime @default(now())
  updateAT DateTime @updatedAt

  notes             Note[]             @relation("UserNotes")
  folders           Folder[]
  comments          Comment[]
  noteCollaborators NoteCollaborator[]

  @@map("users")
}

// Folder Model
model Folder {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  createAT DateTime @default(now())
  updateAT DateTime @updatedAt

  userId String @db.ObjectId
  users  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes Note[]

  @@map("folders")
}

// Note Model
model Note {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  titel      String
  content    String
  isPinned   Boolean  @default(false)
  isArchived Boolean  @default(false)
  createAT   DateTime @default(now())
  updateAT   DateTime @updatedAt

  userId String @db.ObjectId
  users  User   @relation("UserNotes", fields: [userId], references: [id], onDelete: Cascade)

  folderId String @db.ObjectId
  folders  Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  tagId String[] @db.ObjectId
  tags  Tag[]    @relation(fields: [tagId], references: [id])

  attachments       Attachment[]
  comments          Comment[]
  noteCollaborators NoteCollaborator[]

  @@map("notes")
}

// Tag Model
model Tag {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name     String   @unique
  createAT DateTime @default(now())

  noteId String[] @db.ObjectId
  notes  Note[]   @relation(fields: [noteId], references: [id])
}

// Attachment Model
model Attachment {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  fileUrl  String
  fileType String
  fileSize Int
  createAT DateTime @default(now())

  noteId String @db.ObjectId
  notes  Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// Comment Model
model Comment {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  text     String
  createAT DateTime @default(now())

  noteId String @db.ObjectId
  notes  Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  userId String @db.ObjectId
  users  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// NoteCollaborator Model
model NoteCollaborator {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  role     Role     @default(VIEWER)
  createAt DateTime @default(now())

  noteId String @db.ObjectId
  notes  Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  userId String @db.ObjectId
  users  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@map("note_collaborators")
}

enum Role {
  VIEWER
  EDITOR
  OWNER
}

